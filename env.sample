# Server Configuration
PORT=8080
READ_TIMEOUT=30s
WRITE_TIMEOUT=30s
IDLE_TIMEOUT=120s

# Database Configuration
DB_URL=postgres://foodflow:password@localhost:5432/foodflow?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRATION=24h
JWT_ISSUER=foodflow

# Application Configuration
SERVINGS_PER_CREDIT=10
TOKEN_MULTIPLIER=5
CLAIM_COOLOFF_SECONDS=600
RATE_LIMIT_RPS=10
RATE_LIMIT_BURST=20
IDEMPOTENCY_TTL=24h
MONTHLY_CREDITS_BASE=50
MONTHLY_CREDITS_K=0.2
REMOTE_PROXY_BONUS=0.1
